#!/bin/sh
# Runs the full test suite (unit + functional) before each commit.
#
# The functional suite needs a local GGUF model: set LLAMA_NODE_MODEL_PATH,
# or answer the prompt once — the path is cached in test/.model-path.
#
# Bypass for a single commit:  git commit --no-verify   (or SKIP_TESTS=1)
# Install:                     npm run hooks:install

[ "$SKIP_TESTS" = "1" ] && exit 0

echo "pre-commit: running tests (skip with --no-verify or SKIP_TESTS=1)"
exec npm test
